DISCORD_KRUBIT_APPLICATION_ID=123456789012345678
DISCORD_KRUBIT_BOT_TOKEN=
KRUBIT_DATABASE_PATH=data/krubit.db
KRUBIT_STAFF_CHANNEL_ID=
TWITCH_KRUBIT_CLIENT_ID=
TWITCH_KRUBIT_CLIENT_SECRET=
KRUBIT_LIVE_SIGNALS_ENABLED=false

# Phase 2 completion: all social connector credentials below are optional. Krubit
# starts and runs fully without any of them configured; each missing credential only
# keeps the corresponding connector capability at "unconfigured" or
# "authorization_required" instead of preventing startup.
#
# See docs/operations/phase-2-creator-signal-hub.md for the full operator setup guide,
# including two build gaps that are not caused by missing values here: Instagram,
# Facebook, Threads, and TikTok connectors are not wired into the polling scheduler
# yet (they need per-account OAuth credential resolution this build does not
# implement), and the callback server that would receive YouTube push notifications,
# Meta/TikTok OAuth redirects, and Meta signed webhooks is never started by `krubit
# run` yet, regardless of the callback settings below being configured.
YOUTUBE_KRUBIT_API_KEY=
YOUTUBE_KRUBIT_PUSH_CALLBACK_SECRET=
X_KRUBIT_BEARER_TOKEN=
META_KRUBIT_APP_ID=
META_KRUBIT_APP_SECRET=
META_KRUBIT_CALLBACK_BASE_URL=
TIKTOK_KRUBIT_CLIENT_KEY=
TIKTOK_KRUBIT_CLIENT_SECRET=
TIKTOK_KRUBIT_CALLBACK_BASE_URL=
KRUBIT_CREATOR_SIGNALS_ENABLED=false
KRUBIT_SOCIAL_DELIVERY_ENABLED=false
# Required only when storing/reading creator OAuth grants. Use a long random secret,
# e.g. `openssl rand -hex 32`, not a guessable password.
KRUBIT_CREDENTIAL_ENCRYPTION_KEY=
# The callback ingress server binds only when both of these are set; it requires
# KRUBIT_CALLBACK_PUBLIC_BASE_URL to be an https:// URL.
KRUBIT_CALLBACK_PUBLIC_BASE_URL=
KRUBIT_CALLBACK_PORT=

# Phase 3 Watchdog: both flags below default to false and are independently enforced.
# KRUBIT_WATCHDOG_ENABLED=false means join assessment, watch windows, message
# inspection, and the sweep-cycle detectors never run at all.
# KRUBIT_WATCHDOG_NOTIFICATIONS_ENABLED=false means detection can run in shadow mode
# (recording assessments/incidents, queryable via the staff-only /fetch sniff-family
# commands) while never sending a single staff notification.
#
# See docs/operations/phase-3-watchdog.md for the full operator setup guide,
# including the Message Content privileged-intent Developer Portal steps required
# before KRUBIT_WATCHDOG_ENABLED=true can use message-based signals, and five known
# build gaps that are not caused by missing values here — most importantly, a lone
# member whose join alone crosses the INCIDENT risk band is never notified to staff
# in real time in this build; only the periodic sweep-cycle detectors ever notify.
KRUBIT_WATCHDOG_ENABLED=false
KRUBIT_WATCHDOG_NOTIFICATIONS_ENABLED=false
KRUBIT_WATCHDOG_WATCH_WINDOW_HOURS=
# Forward-declared only — nothing in this build reads this value; "notify Zariya" is
# not implemented in Phase 3, only "notify staff" (the Discord staff channel). Must
# be an https:// URL if set.
KRUBIT_WATCHDOG_ZARIYA_BRIDGE_URL=
